# ---- Dependencies ----
node_modules/

# ---- Graphify knowledge graph (regenerated output) ----
graphify-out/

# ---- Environment files (never commit secrets) ----
.env
.env.*
!.env.example
!.env*.example

# ---- Admin (Next.js) ----
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.vercel

# ---- Mobile (Expo / React Native) ----
.expo/
dist/
web-build/
expo-env.d.ts

# ---- Native ----
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ---- Metro ----
.metro-health-check*

# ---- Supabase CLI ----
# Machine-local link state: project ref, cached version pins. Not source.
# admin/.gitignore already scopes this inside admin/, where the real project
# lives; this catches the same directory appearing at the repo root when a
# supabase command is run from the wrong working directory.
supabase/.temp/

# ---- Testing ----
coverage/

# ---- Logs / debug ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Playwright MCP ----
.playwright-mcp/

# ---- Local verification logs ----
# Saved output of scripts/verify.sh. Machine-local, never source.
.verify-*.txt

# ---- macOS ----
.DS_Store
*.pem