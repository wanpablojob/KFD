# ------------------------------------------------------------------
# KFD mobile environment variables
#
#   cp .env.example .env.local   then fill in the values marked TODO.
#
# Rules:
#   - Every EXPO_PUBLIC_ variable is embedded in the app bundle and is
#     therefore PUBLIC. Never put a service role key, a database
#     password or any other secret in this file. The publishable key is
#     public by design; the service role key is not, and it belongs only
#     on the server (admin/.env.example).
#   - A local .env.local is NOT used by an EAS build. For a store build
#     the same variable names must be set in the EAS environment
#     ("preview" and "production"). A name missing there produces a
#     bundle that boots against an undefined URL instead of an error,
#     which is why scripts/phase-c-preflight.sh checks the list below
#     against what the code actually reads.
# ------------------------------------------------------------------

# ---- Required: the app cannot sign in without these ---------------

# Supabase -> Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase -> Project Settings -> API -> Publishable key ("sb_publishable_…")
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Required: order alerts and push registration ------------------

# Public HTTPS origin of the admin API. The phone has to reach it, so
# it must be a real https URL -- not a LAN address and not localhost.
EXPO_PUBLIC_API_URL=

# ---- Optional ------------------------------------------------------

# EAS project id. Set it in the EAS environment so a build is linked
# to the project. Over-the-air updates are not part of launch, so a
# missing value only costs you the release tag in crash reports.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Release tag attached to crash reports. EAS does not set this for you: the
# build variables it does set are named EAS_BUILD_*. Set it in the EAS
# environment, or the app falls back to 1.0.0 and files every production
# crash under the wrong version.
EXPO_PUBLIC_EAS_BUILD_VERSION=

# Sentry DSN. Without it, crash reporting stays off and the app logs
# that it is off rather than failing.
EXPO_PUBLIC_SENTRY_DSN=
