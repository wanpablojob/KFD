# ------------------------------------------------------------------
# KFD Mobile environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env files or real secret values.
#
# Anything prefixed EXPO_PUBLIC_ is embedded in the client bundle and is
# therefore PUBLIC. Use the project URL and the publishable (anon) key only.
# Never put a service role key here.
# ------------------------------------------------------------------

# Public variables
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=