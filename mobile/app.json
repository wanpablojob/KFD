{
  "expo": {
    "name": "Kabankalan Food Delivery",
    "slug": "kfd-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kfd",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.kabankalan.kfd",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ph.kabankalan.kfd",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo of the delivered order so the delivery can be confirmed.",
          "cameraPermission": "Take a photo of the delivered order to confirm delivery.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8E7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A3130A",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KFD shares your location with the customer while you deliver their order, so they can see you are on the way."
        }
      ]
    ]
  }
}
