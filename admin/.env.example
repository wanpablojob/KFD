# ------------------------------------------------------------------
# KFD Admin environment variables
#
#   cp .env.example .env.local   then fill in the values marked TODO.
#
# Rules:
#   - Never commit .env.local or any real secret value.
#   - Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
#     Only put values there that are safe for a stranger to read.
#   - Server secrets must NOT have the NEXT_PUBLIC_ prefix. The publishable
#     key is already public; the service role key is not, and it bypasses
#     Row Level Security, so it must only ever exist server-side.
# ------------------------------------------------------------------

# ---- Required: app boots and authenticates -------------------------

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → Publishable key ("sb_publishable_…")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key. Only a fallback: the publishable key above is used when
# both are set, which is the normal case. Leave blank unless you know you
# need it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Required for email only ---------------------------------------
# Without these, orders and menu still work. Accept/reject saves the status
# change and reports that the customer email was not sent. The UI tells the
# merchant this rather than failing silently.

# Supabase → Project Settings → API → service_role key ("sb_secret_…")
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. Starts with "re_".
RESEND_API_KEY=

# Resend → Domains, after verifying a sending domain. The "onboarding@resend.dev"
# fallback only works for your own Resend account address, so it cannot be used
# to email real customers.
ORDER_EMAIL_FROM="KFD <orders@your-verified-domain.com>"

# ---- Not needed by the app -----------------------------------------
# The Supabase CLI reads these for migrations only. They are not used by
# `npm run dev` or `npm run build`; `supabase link` stores the connection
# for you, so you can usually ignore them.
# DATABASE_URL=
# SUPABASE_URL=
# JWT_SECRET=
