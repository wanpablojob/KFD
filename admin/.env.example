# ------------------------------------------------------------------
# KFD Admin environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env files or real secret values.
# ------------------------------------------------------------------

# Public variables (safe for the browser, prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=

# Supabase (project URL + publishable key are safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------
# Server-side secrets (NEVER prefix with NEXT_PUBLIC_ ...)
# ------------------------------------------------------------------

# Database (Supabase PostgreSQL — for migrations / CLI only)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication
JWT_SECRET=