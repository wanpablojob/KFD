{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "agents": {
    "build": {
      "model": "opencode/minimax-m3.1-flash-free#max",
      "steps": 100
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    }
  },
  "tool_output": {
    "max_lines": 4000,
    "max_bytes": 102400
  },
  "formatter": true,
  "snapshots": true,
  "worktree": {
    "directory": "~/KFD-worktrees"
  },
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "/Users/alexagracegeogangco/.local/bin/graphify-mcp",
        "/Users/alexagracegeogangco/KFD/graphify-out/graph.json"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["bash", "scripts/mcp-server.sh", "playwright"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["bash", "scripts/mcp-server.sh", "context7"],
      "enabled": true
    },
    "firebase": {
      "type": "local",
      "command": ["bash", "scripts/mcp-server.sh", "firebase"],
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=ijeqwbrrgfsmymsektih&read_only=true&features=database,docs,debugging"
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com"
    }
  }
}